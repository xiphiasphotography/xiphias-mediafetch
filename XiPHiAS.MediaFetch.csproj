<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>XiPHiAS.MediaFetch</RootNamespace>
    <AssemblyName>XiPHiAS.MediaFetch</AssemblyName>

    <Version>0.2.2</Version>
    <AssemblyVersion>0.2.2.0</AssemblyVersion>
    <FileVersion>0.2.2.0</FileVersion>
    <InformationalVersion>0.2.2</InformationalVersion>
    <Product>XiPHiAS MediaFetch</Product>
    <Title>XiPHiAS MediaFetch</Title>
    <AssemblyTitle>XiPHiAS MediaFetch</AssemblyTitle>
    <Description>Lightweight Windows bulk media downloader</Description>
    <Company>XiPHiAS</Company>
    <Authors>XiPHiAS</Authors>
    <Copyright>Copyright © 2026 XiPHiAS</Copyright>
    <NeutralLanguage>nl-NL</NeutralLanguage>

    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\XiPHiAS.MediaFetch-logo.png"
                      LogicalName="XiPHiAS.MediaFetch.Logo.png" />
  </ItemGroup>
</Project>
